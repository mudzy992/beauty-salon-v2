# Local development template only. Never put real secrets in this tracked file.
DATABASE_PROVIDER=postgres
DATABASE_URL="postgresql://USER:SET_LOCAL_PASSWORD@localhost:5432/beauty_salon_dev?schema=public"

# Generate a unique random value for each environment; do not reuse this comment/template.
# Example generator: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=REPLACE_WITH_A_RANDOM_LOCAL_ONLY_SECRET
JWT_EXPIRES_IN=7d

# The Vite dev proxy and Compose backend default to port 10001.
PORT=10001
UPLOAD_ROOT=./uploads

# Shared Socket.IO Redis is reachable only from the backend over external Docker network redis_net.
# Dedicated ACL user for this app's Socket.IO adapter; do not reuse another app/BullMQ worker user.
# Use redis:// for an internal non-TLS listener, or rediss:// if Redis TLS is enabled.
# Keep the ACL password in the runtime secret store; URL-encode special characters in it.
#SOCKET_IO_MULTI_INSTANCE=true
#SOCKET_IO_REDIS_URL=redis://<acl-user>:<url-encoded-password>@redis-core:6379
#SOCKET_IO_REDIS_CHANNEL_PREFIX=beauty-salon-v2:production
# All replicas in this app/environment use the same prefix; other apps/environments use another.
# Redis ACL should restrict Pub/Sub channels to &beauty-salon-v2:production* and grant only the
# adapter's HELLO/PUBLISH/SUBSCRIBE/PSUBSCRIBE/UNSUBSCRIBE/PUNSUBSCRIBE/PUBSUB NUMSUB commands.
# For a deliberate single-instance run without the Redis adapter:
#SOCKET_IO_MULTI_INSTANCE=false
#SOCKET_IO_REDIS_URL=

# Required before storing secret AppSetting values. Keep the key in a runtime secret store.
#APP_SETTINGS_ENCRYPTION_KEY=<base64-encoded-32-random-bytes>
# Optional Expo push access token; configure only in ignored local env/runtime secrets.
#EXPO_ACCESS_TOKEN=
