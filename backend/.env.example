# Local development template only. Never put real secrets in this tracked file.
DATABASE_PROVIDER=postgres
DATABASE_URL="postgresql://USER:SET_LOCAL_PASSWORD@localhost:5432/beauty_salon_dev?schema=public"
# Coolify PostgreSQL TLS: add sslmode=verify-full&sslrootcert=/etc/ssl/certs/coolify-ca.crt.
# Use a literal '&' in DATABASE_URL (not HTML '&amp;'); append with '&' if a query already exists.

# Generate a unique random value for each environment; do not reuse this comment/template.
# Example generator: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=REPLACE_WITH_A_RANDOM_LOCAL_ONLY_SECRET
JWT_EXPIRES_IN=7d

# The Vite dev proxy and Compose backend default to port 10001.
PORT=10001
UPLOAD_ROOT=./uploads

# Shared Redis is reachable only from the backend over external Docker network redis_net.
# Production Compose defaults TLS on and mounts the host CA at /run/secrets/redis-ca.crt.
# Override REDIS_TLS=false only when the configured Redis listener intentionally uses plaintext.
#REDIS_TLS=true
#REDIS_CA_CERT_PATH=/run/secrets/redis-ca.crt
# Dedicated ACL user for this app's Socket.IO adapter; do not reuse another app/BullMQ worker user.
# REDIS_TLS=true enables TLS even when the existing URL is redis://; rediss:// also enables TLS.
# Keep the ACL password in the runtime secret store; URL-encode special characters in it.
#SOCKET_IO_MULTI_INSTANCE=true
#SOCKET_IO_REDIS_URL=redis://<acl-user>:<url-encoded-password>@redis-core:6379
#SOCKET_IO_REDIS_CHANNEL_PREFIX=beauty-salon-v2:production
# All replicas in this app/environment use the same prefix; other apps/environments use another.
# Redis 7 ACL: the adapter's PSUBSCRIBE pattern must be an exact channel ACL entry.
# For the root namespace and this adapter key, include &beauty-salon-v2:production#/#*;
# request/response channels can be scoped to &beauty-salon-v2:production-request#/# and
# &beauty-salon-v2:production-response#/#*. A broad &beauty-salon-v2:production* alone
# does not authorize that PSUBSCRIBE pattern. Verify the rules with ACL DRYRUN.
# Grant only HELLO/PUBLISH/SUBSCRIBE/PSUBSCRIBE/UNSUBSCRIBE/PUNSUBSCRIBE/PUBSUB NUMSUB.
# For a deliberate single-instance run without the Redis adapter:
#SOCKET_IO_MULTI_INSTANCE=false
#SOCKET_IO_REDIS_URL=

# Dedicated HTTP rate-limit Redis ACL user, separate from the Socket.IO ACL user.
# Grant only EVAL/INCR/TTL/EXPIRE and key access to <HTTP_RATE_LIMIT_PREFIX>:*.
# The store uses no Redis Pub/Sub channels; verify command/key scope with ACL DRYRUN.
# If unset/unavailable, HTTP rate limits fail open and log a warning.
# Keep credentials in the runtime secret store; never commit an actual Redis URL/password.
#HTTP_RATE_LIMIT_REDIS_URL=redis://<http-rate-limit-acl-user>:<url-encoded-password>@redis-core:6379
#HTTP_RATE_LIMIT_PREFIX=beauty-salon-v2:http-rate-limit:production

# Required before storing secret AppSetting values. Keep the key in a runtime secret store.
#APP_SETTINGS_ENCRYPTION_KEY=<base64-encoded-32-random-bytes>
# Optional Expo push access token; configure only in ignored local env/runtime secrets.
#EXPO_ACCESS_TOKEN=
