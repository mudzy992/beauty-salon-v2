# Database (MySQL). Inicijalizacija: npm run db:migrate && npm run db:seed (ili npm run db:init)
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/beauty-salon-v2"

# JWT
JWT_SECRET=change-me-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# Uploads - host path bound to container /usr/app/uploads
UPLOAD_ROOT=/usr/app/uploads

# Port (u Dockeru 10001 za Traefik)
PORT=3000

# Expo Push (opciono). Za slanje push notifikacija na mobilnu app koristi se Expo Push API.
# Access token: https://expo.dev/accounts/[account]/settings/access-tokens
#EXPO_ACCESS_TOKEN=

# App settings encryption (base64 32 bytes). Used to encrypt secret app_settings values.
# Generate example (node): node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#APP_SETTINGS_ENCRYPTION_KEY=
