{
  "name": "beauty-salon-v2-frontend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "tsc -b && vite build --config vite.config.ts",
    "test:socket-recovery": "node --test src/context/socket-recovery.test.mjs",
    "test:brand-colors": "node --test src/utils/brand-colors.test.mjs",
    "test:registration-errors": "node --test src/features/auth/registration-error.test.mjs",
    "test:locale-formatting": "node --test src/i18n/locale-utils.test.mjs",
    "test:reservation-errors": "node --test src/features/reservations/public-reservation-error.test.mjs",
    "test:client-reservation-errors": "node --test src/features/client-reservations/client-reservation-error.test.mjs",
    "test:admin-api-errors": "node --test src/features/admin/admin-api-error.test.mjs",
    "test:profile-api-errors": "node --test src/features/profile/profile-api-error.test.mjs",
    "test:i18n-language": "node --test src/i18n/language.test.mjs",
    "gen:favicons": "node ./scripts/generate-favicons.mjs",
    "preview": "vite preview --port 10000 --config vite.config.ts",
    "lint": "eslint . --ext ts,tsx"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
