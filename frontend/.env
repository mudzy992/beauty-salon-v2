# Base URL backend API-ja. Prazno = relativne putanje (proxy u dev na localhost:3000).
# U produkciji npr. https://nejra-v2.ba101.top/backend
VITE_API_URL=https://nejra-v2.ba101.top/backend
# Base URL za uploadane fajlove (slike, PDF). Backend servira na /uploads/
# Ako prazno, koristi se VITE_API_URL. Npr. https://nejra-v2.ba101.top/backend/uploads
VITE_API_FILES_URL=https://nejra-v2.ba101.top/backend/uploads
