EXPO_PUBLIC_API_URL=https://api.nejra.ba101.top
# Base URL za uploadane fajlove (slike, PDF). Ako prazno, koristi se EXPO_PUBLIC_API_URL + /uploads
EXPO_PUBLIC_API_FILES_URL=https://api.nejra.ba101.top/uploads

# Push notifikacije: 'true' samo kad koristiš dev build / EAS Build (u Expo Go na Androidu remote push ne radi od SDK 53).
#EXPO_PUBLIC_PUSH_ENABLED=false

# EAS projectId (obavezno za push token). Dobij ga s: npx eas init
EXPO_PUBLIC_EAS_PROJECT_ID=a697c506-8426-4064-99d8-780f9fc70700
