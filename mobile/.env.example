# These are public API URLs, not credentials. Select a host reachable from the device.
# Android emulator example: http://10.0.2.2:10001
# iOS simulator/physical device: use the reachable local host/LAN address for your environment.
EXPO_PUBLIC_API_URL=http://10.0.2.2:10001
EXPO_PUBLIC_API_FILES_URL=http://10.0.2.2:10001/uploads
EXPO_PUBLIC_PUSH_ENABLED=false

# Optional EAS project identifier. It is public app configuration, not an access token.
#EXPO_PUBLIC_EAS_PROJECT_ID=
